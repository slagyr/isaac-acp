{:paths ["src"]

 ;; ACP is a module (the :isaac/cli berth + comm impl). It depends on the
 ;; split platform repos — agent (runtime: bridge, drive, llm, sessions,
 ;; tools), HTTP (routes), foundation (cli/loader/config/nexus, transitive)
 ;; — NOT the legacy monolith.
 :deps  {io.github.slagyr/isaac-foundation {:git/url "https://github.com/slagyr/isaac-foundation.git"
                                            :git/sha "ad0a97b7f039814dc92916299baf3c07a5b86f3a"}
         io.github.slagyr/isaac-agent      {:git/url "https://github.com/slagyr/isaac-agent.git"
                                            :git/sha "8aecfc3a57fef0803c35f81bd4a3f76292b227f1"}
         io.github.slagyr/isaac-http     {:git/url "https://github.com/slagyr/isaac-http.git"
                                            :git/sha "11e43014ad5c7b9c8bb693e0eb4f673bbd23991d"}
         com.cleancoders.c3kit/apron       {:mvn/version "3.0.0"}
         cheshire/cheshire                 {:mvn/version "5.13.0"}
         org.clojure/tools.cli             {:mvn/version "1.1.230"}}

 :aliases
 {:dev-local {:override-deps {io.github.slagyr/isaac-agent                   {:local/root "../isaac-agent"}
                              io.github.slagyr/isaac-agent-spec              {:local/root "../isaac-agent/spec"}
                              io.github.slagyr/isaac-http                  {:local/root "../isaac-http"}
                              io.github.slagyr/isaac-foundation              {:local/root "../isaac-foundation"}
                              io.github.slagyr/isaac-foundation-spec         {:local/root "../isaac-foundation/spec"}
                              io.github.slagyr/isaac-foundation-test-support {:local/root "../isaac-foundation/spec-support"}
                              io.github.slagyr/isaac-http-test-support     {:local/root "../isaac-http/spec-support"}
                              marigold.bridge/marigold.bridge                {:local/root "../isaac-foundation/modules/marigold.bridge"}
                              marigold.longwave/marigold.longwave            {:local/root "../isaac-foundation/modules/marigold.longwave"}}}

  :spec {:extra-paths ["spec"]
         :extra-deps  {io.github.slagyr/isaac-foundation-spec         {:git/url   "https://github.com/slagyr/isaac-foundation.git"
                                                                       :git/sha   "ad0a97b7f039814dc92916299baf3c07a5b86f3a"
                                                                       :deps/root "spec"}
                       io.github.slagyr/isaac-foundation-test-support {:git/url   "https://github.com/slagyr/isaac-foundation.git"
                                                                       :git/sha   "ad0a97b7f039814dc92916299baf3c07a5b86f3a"
                                                                       :deps/root "spec-support"}
                       io.github.slagyr/isaac-agent-spec              {:git/url   "https://github.com/slagyr/isaac-agent.git"
                                                                       :git/sha   "8aecfc3a57fef0803c35f81bd4a3f76292b227f1"
                                                                       :deps/root "spec"}
                       io.github.slagyr/isaac-episodes                 {:git/url "https://github.com/slagyr/isaac-episodes.git"
                                                                       :git/sha "0cbe24b55a2d94be0579a2400a11163748d5913d"
                                                                       :exclusions [io.github.slagyr/isaac-agent
                                                                                    io.github.slagyr/isaac-agent-spec
                                                                                    io.github.slagyr/isaac-foundation
                                                                                    io.github.slagyr/isaac-foundation-spec
                                                                                    io.github.slagyr/isaac-foundation-test-support
                                                                                    io.github.slagyr/isaac-http]}
                       io.github.slagyr/isaac-http-test-support     {:git/url   "https://github.com/slagyr/isaac-http.git"
                                                                       :git/sha   "11e43014ad5c7b9c8bb693e0eb4f673bbd23991d"
                                                                       :deps/root "spec-support"}
                       speclj/speclj                                  {:mvn/version "3.13.0"}
                       babashka/process                               {:mvn/version "0.5.22"}
                       io.github.slagyr/gherclj                       {:git/tag "v1.3.0" :git/sha "9c3bb1d"}}
         :main-opts   ["-m" "speclj.main" "-c" "-D" "spec"]}

  :features {:extra-paths ["spec"]
             :extra-deps  {io.github.slagyr/isaac-agent-spec              {:git/url   "https://github.com/slagyr/isaac-agent.git"
                                                                            :git/sha   "8aecfc3a57fef0803c35f81bd4a3f76292b227f1"
                                                                            :deps/root "spec"}
                           io.github.slagyr/isaac-episodes                  {:git/url "https://github.com/slagyr/isaac-episodes.git"
                                                                            :git/sha "0cbe24b55a2d94be0579a2400a11163748d5913d"}
                           io.github.slagyr/isaac-foundation-spec          {:git/url   "https://github.com/slagyr/isaac-foundation.git"
                                                                            :git/sha   "ad0a97b7f039814dc92916299baf3c07a5b86f3a"
                                                                            :deps/root "spec"}
                           io.github.slagyr/isaac-foundation-test-support  {:git/url   "https://github.com/slagyr/isaac-foundation.git"
                                                                            :git/sha   "ad0a97b7f039814dc92916299baf3c07a5b86f3a"
                                                                            :deps/root "spec-support"}
                           io.github.slagyr/isaac-http-test-support        {:git/url   "https://github.com/slagyr/isaac-http.git"
                                                                            :git/sha   "11e43014ad5c7b9c8bb693e0eb4f673bbd23991d"
                                                                            :deps/root "spec-support"}
                           babashka/process                                {:mvn/version "0.5.22"}
                           io.github.slagyr/gherclj                        {:git/tag "v1.3.0" :git/sha "9c3bb1d"}
                           speclj/speclj                                   {:mvn/version "3.13.0"}}
             :main-opts   ["-m" "gherclj.main"
                           "-f" "features"
                           "-s" "isaac.foundation.fs-steps"
                           "-s" "isaac.foundation.root-steps"
                           "-s" "isaac.foundation.harness-config-steps"
                           "-s" "isaac.foundation.cli-steps"
                           "-s" "isaac.foundation.log-steps"
                           "-s" "isaac.session.session-steps"
                           "-s" "isaac.tool.tools-steps"
                           "-s" "isaac.llm.providers-steps"
                           "-s" "isaac.comm.acp.acp-steps"
                           "-t" "~slow"
                           "-t" "~wip"]}}}
